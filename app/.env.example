# Base URL of the scale-v2 control plane API.
#
# REQUIRED for any deployment where the front end and the API are on different
# origins — which includes the Vercel deployment, since Vercel serves only the
# static bundle in app/dist and runs no backend. If this is unset there, every
# API call lands on static hosting and fails (a POST returns 405).
#
# Leave EMPTY only when the front end is served from the same origin as the API
# (e.g. built into scale-v2/public), where relative /api paths resolve correctly.
#
# Local development against a locally running control plane:
#   VITE_API_BASE=http://127.0.0.1:3001
VITE_API_BASE=

# Public base URL for the Empire Auto Cofounder API.
# Example: https://cofounder-api.empire1.cloud
VITE_COFOUNDER_API_URL=
